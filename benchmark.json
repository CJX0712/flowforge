  "failure_cases": [
    {
      "case": "torus3: flagship does not beat GMM",
      "evidence": "FlowFuse 3.6812\u00b10.1064 vs GMM 3.3499 (gap -0.3313, -9.89%)",
      "attribution": "Thin-manifold + few training steps: a torus is a 2-D surface in 3-D, which a 16-component GMM tiles cheaply, while a smooth diffeomorphism must bend all of space to represent it. A flow *contains* the Gaussian as a special case, so this is an optimisation-budget failure, not a capacity failure."
    },
    {
      "case": "warp8: member RealNVP-b6 is worse than baseline Gauss-full",
      "evidence": "RealNVP-b6 10.2394 vs baseline 10.2360",
      "attribution": "Architecture/DGP mismatch. This is the reason FlowFuse uses a gain gate: a mis-matched member must not be allowed to dictate the shipped density."
    },
